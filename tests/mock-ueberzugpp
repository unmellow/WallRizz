#!/usr/bin/env bash
# Mock Überzug++ for tests: records argv and every stdin line to $MOCK_UZ_LOG.
# MOCK_UZ_FAIL=1:        exit at once (ueberzugpp can't start)
# MOCK_UZ_HANG=1:        ignore SIGTERM and stdin EOF (forces SIGKILL on stop)
# MOCK_UZ_TIMES=FILE:    also append "<epoch seconds.micro> <action> <id>" per line
# MOCK_UZ_DIE_AFTER=N:   abort (SIGABRT, like ueberzugpp 2.9.10 on a burst)
#                        after the N-th command of this instance
# MOCK_UZ_CLOSE_STDIN=1: close stdin and keep running (writes get EPIPE)
# MOCK_UZ_DIE_SKIP=N:    the first N instances (counted in the log) don't die
# MOCK_SWAY_EVENTS=FILE: emulate sway: every add's window is "mapped" (a sway
#                        window event with this pid appended to FILE, and
#                        "MAPPED <id> <epoch>" to the log) MOCK_UZ_MAP_MS
#                        (default 100) after the previous window was, the
#                        first one MOCK_UZ_FIRST_MAP_MS after its add (one
#                        window at a time, in order, like ueberzugpp); an
#                        add removed before its window is due never maps
#                        (no event), as with the real ueberzugpp
# MOCK_UZ_NO_MAP=1:      ... except that no window is ever reported
log=${MOCK_UZ_LOG:-/tmp/mock-ueberzugpp.log}
instance=$(grep -c '^ARGV' "$log" 2>/dev/null)
echo "ARGV $*" >> "$log"
[[ -n $MOCK_UZ_PIDS ]] && echo "$$" >> "$MOCK_UZ_PIDS"
(( instance < ${MOCK_UZ_DIE_SKIP:-0} )) && MOCK_UZ_DIE_AFTER=
[[ -n $MOCK_UZ_FAIL ]] && exit 1
if [[ -n $MOCK_UZ_HANG ]]; then
  trap '' TERM
  while :; do sleep 0.05; done
fi
if [[ -n $MOCK_UZ_CLOSE_STDIN ]]; then
  exec 0<&-
  sleep 5
  exit 0
fi
trap 'echo "SIGTERM" >> "$log"; exit 0' TERM
n=0
mapped_at=0 # (microseconds) when the last window was mapped
maps=0
us() { local t=${EPOCHREALTIME/./}; echo $((10#$t)); }
gone_dir=$log.gone.$$
emit_map() { # id due_us con_id
  local wait=$(( $2 - $(us) ))
  (( wait > 0 )) && sleep "$(printf '%d.%06d' $((wait / 1000000)) $((wait % 1000000)))"
  if [[ -e $gone_dir/$1 ]]; then echo "UNMAPPED $1 $EPOCHREALTIME" >> "$log"; return; fi
  echo "{\"change\":\"new\",\"container\":{\"id\":$3,\"app_id\":\"ueberzugpp_mock$3\",\"pid\":$$,\"visible\":true}}" >> "$MOCK_SWAY_EVENTS"
  echo "MAPPED $1 $EPOCHREALTIME" >> "$log"
}
while IFS= read -r line; do
  echo "CMD $line" >> "$log"
  if [[ -n $MOCK_SWAY_EVENTS && -z $MOCK_UZ_NO_MAP &&
        $line =~ \"action\":\"add\",\"identifier\":\"([^\"]+)\" ]]; then
    now=$(us)
    if (( maps == 0 )); then due=$(( now + ${MOCK_UZ_FIRST_MAP_MS:-${MOCK_UZ_MAP_MS:-100}} * 1000 ))
    else due=$(( (now > mapped_at ? now : mapped_at) + ${MOCK_UZ_MAP_MS:-100} * 1000 )); fi
    mapped_at=$due
    maps=$((maps + 1))
    emit_map "${BASH_REMATCH[1]}" "$due" "$$$maps" &
  elif [[ -n $MOCK_SWAY_EVENTS && $line =~ \"action\":\"remove\",\"identifier\":\"([^\"]+)\" ]]; then
    mkdir -p "$gone_dir" && : > "$gone_dir/${BASH_REMATCH[1]}"
  fi
  if [[ -n $MOCK_UZ_TIMES ]]; then
    [[ $line =~ \"action\":\"([a-z]+)\",\"identifier\":\"([^\"]+)\" ]] &&
      echo "$EPOCHREALTIME ${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" >> "$MOCK_UZ_TIMES"
  fi
  n=$((n + 1))
  if [[ -n $MOCK_UZ_DIE_AFTER && $n -ge $MOCK_UZ_DIE_AFTER ]]; then
    echo "ABORT" >> "$log"
    trap - ABRT
    kill -ABRT $$
  fi
done
rm -rf "$gone_dir"
echo "EOF" >> "$log"
